{
  "name": "stock-watcher",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:ui dev:proxy",
    "dev:ui": "npm --prefix my-remix-app run dev",
    "dev:proxy": "npm run proxy",
    "proxy": "node --max-http-header-size=65536 ticker_proxy.js",
    "start": "npm --prefix my-remix-app run start",
    "typecheck": "npm --prefix my-remix-app run typecheck",
    "test": "node --test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "kiteconnect": "^5.3.0",
    "sharekhan-api": "github:Sharekhan-API/shareconnectnodejs"
  }
}
